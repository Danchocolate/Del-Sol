{
  "name": "hotel-del-sol",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "scripts": {
    "predev": "npm run build -w @hotel/shared",
    "dev": "concurrently -k -n api,web,worker \"npm run dev -w @hotel/api\" \"npm run dev -w @hotel/web\" \"npm run worker -w @hotel/api\"",
    "build": "npm run build -w @hotel/shared && npm run build -w @hotel/api && npm run build -w @hotel/web",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tests.json",
    "lint": "eslint apps packages tests scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "pretest": "npm run build -w @hotel/shared",
    "test": "vitest run",
    "pretest:integration": "npm run build -w @hotel/shared",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "pretest:e2e": "npm run build -w @hotel/shared && npm run build -w @hotel/web",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate --schema apps/api/prisma/schema.prisma",
    "db:migrate": "prisma migrate deploy --schema apps/api/prisma/schema.prisma",
    "db:seed": "tsx --env-file=.env apps/api/prisma/seed.ts",
    "db:bootstrap-admin": "node scripts/bootstrap-admin.mjs",
    "dev:setup": "node scripts/setup-local.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.2",
    "concurrently": "10.0.5",
    "dotenv": "18.0.3",
    "eslint": "10.11.0",
    "globals": "17.12.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.8",
    "prisma": "6.19.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vitest": "4.1.11"
  },
  "overrides": {
    "deepmerge-ts": "8.0.0"
  }
}
