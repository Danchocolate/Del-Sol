generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
}
enum Role {
  SUPER_ADMIN
  MANAGER
  FRONT_DESK
  CONTENT_EDITOR
}
enum ReservationStatus {
  PENDING_EMAIL_VERIFICATION
  PENDING_CONFIRMATION
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  NO_SHOW
  EXPIRED
}
enum ReservationSource {
  DIRECT
  WALK_IN
  PHONE
  AGODA
  BOOKING_COM
  EXPEDIA
  AIRBNB
  CHANNEL_MANAGER
}
enum PaymentMethod {
  CASH
  GCASH
  MAYA
  CARD_TERMINAL
  BANK_TRANSFER
  OTHER
}
enum DiscountKind {
  PERCENTAGE
  FIXED
}
model User {
  id String @id
  name String
  email String @unique
  emailVerified Boolean @default(false)
  image String?
  role Role @default(FRONT_DESK)
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sessions Session[]
  accounts Account[]
}
model Session {
  id String @id
  expiresAt DateTime
  token String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}
model Account {
  id String @id
  accountId String
  providerId String
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken String?
  refreshToken String?
  idToken String?
  accessTokenExpiresAt DateTime?
  refreshTokenExpiresAt DateTime?
  scope String?
  password String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId])
}
model Verification {
  id String @id
  identifier String
  value String
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([identifier])
}
model RateLimit {
  id String @id @default(cuid())
  key String @unique
  count Int
  lastRequest BigInt
}
model Guest {
  id String @id @default(uuid())
  name String
  email String
  mobile String?
  createdAt DateTime @default(now())
  reservations Reservation[]
  @@index([email])
}
model RoomType {
  id String @id @default(uuid())
  slug String @unique
  name String
  description String
  capacity Int
  basePrice Int
  sizeSqm Int
  bed String
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rooms Room[]
  images RoomImage[]
  amenities RoomAmenity[]
  promotions PromotionRoomType[]
}
model Room {
  id String @id @default(uuid())
  number String @unique
  roomTypeId String
  roomType RoomType @relation(fields: [roomTypeId], references: [id])
  capacity Int
  basePrice Int?
  active Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  allocations ReservationRoom[]
  blocks RoomBlock[]
  promotions PromotionRoom[]
}
model Amenity {
  id String @id @default(uuid())
  name String @unique
  roomTypes RoomAmenity[]
}
model RoomAmenity {
  roomTypeId String
  amenityId String
  roomType RoomType @relation(fields: [roomTypeId], references: [id])
  amenity Amenity @relation(fields: [amenityId], references: [id])
  @@id([roomTypeId, amenityId])
}
model RoomImage {
  id String @id @default(uuid())
  roomTypeId String
  roomType RoomType @relation(fields: [roomTypeId], references: [id])
  objectKey String
  url String
  alt String
  position Int @default(0)
  archived Boolean @default(false)
}
model RoomBlock {
  id String @id @default(uuid())
  roomId String
  room Room @relation(fields: [roomId], references: [id])
  startDate DateTime @db.Date
  endDate DateTime @db.Date
  reason String
  active Boolean @default(true)
  createdAt DateTime @default(now())
}
model Reservation {
  id String @id @default(uuid())
  reference String @unique
  idempotencyKey String @unique
  requestHash String
  guestId String
  guest Guest @relation(fields: [guestId], references: [id])
  status ReservationStatus
  source ReservationSource @default(DIRECT)
  checkIn DateTime @db.Date
  checkOut DateTime @db.Date
  guestCount Int
  roomCount Int
  currency String @default("PHP")
  subtotal Int
  discount Int
  total Int
  priceSnapshot Json
  policySnapshot Json
  expiresAt DateTime?
  emailVerifiedAt DateTime?
  cancelledAt DateTime?
  cancellationReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  rooms ReservationRoom[]
  history ReservationStatusHistory[]
  events ReservationEvent[]
  tokens VerificationToken[]
  grants GuestGrant[]
  payments Payment[]
  redemption PromotionRedemption?
  @@index([status, checkIn])
  @@index([status, expiresAt])
}
model ReservationRoom {
  id String @id @default(uuid())
  reservationId String
  reservation Reservation @relation(fields: [reservationId], references: [id])
  roomId String
  room Room @relation(fields: [roomId], references: [id])
  checkIn DateTime @db.Date
  checkOut DateTime @db.Date
  active Boolean @default(true)
  nightlyRate Int
  roomName String
  @@unique([reservationId, roomId])
  @@index([roomId, active, checkIn, checkOut])
}
model ReservationStatusHistory {
  id String @id @default(uuid())
  reservationId String
  reservation Reservation @relation(fields: [reservationId], references: [id])
  fromStatus ReservationStatus?
  toStatus ReservationStatus
  actorId String?
  reason String?
  createdAt DateTime @default(now())
}
model ReservationEvent {
  id String @id @default(uuid())
  reservationId String
  reservation Reservation @relation(fields: [reservationId], references: [id])
  kind String
  metadata Json
  createdAt DateTime @default(now())
}
model VerificationToken {
  id String @id @default(uuid())
  reservationId String
  reservation Reservation @relation(fields: [reservationId], references: [id])
  purpose String
  tokenHash String @unique
  expiresAt DateTime
  usedAt DateTime?
  createdAt DateTime @default(now())
  @@index([reservationId, purpose])
}
model GuestGrant {
  id String @id @default(uuid())
  reservationId String
  reservation Reservation @relation(fields: [reservationId], references: [id])
  tokenHash String @unique
  expiresAt DateTime
  createdAt DateTime @default(now())
}
model Payment {
  id String @id @default(uuid())
  reservationId String
  reservation Reservation @relation(fields: [reservationId], references: [id])
  idempotencyKey String @unique
  amount Int
  method PaymentMethod
  paidAt DateTime
  receipt String
  notes String?
  recordedBy String
  status String @default("POSTED")
  reversalOfId String? @unique
  reversalOf Payment? @relation("Reversal",fields:[reversalOfId],references:[id])
  reversal Payment? @relation("Reversal")
  createdAt DateTime @default(now())
  @@index([paidAt])
}
model Promotion {
  id String @id @default(uuid())
  code String @unique
  name String
  kind DiscountKind
  value Int
  active Boolean @default(true)
  startsAt DateTime
  endsAt DateTime
  stayStartsAt DateTime? @db.Date
  stayEndsAt DateTime? @db.Date
  minNights Int @default(1)
  usageLimit Int
  perEmailLimit Int @default(1)
  allRooms Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  roomTypes PromotionRoomType[]
  rooms PromotionRoom[]
  redemptions PromotionRedemption[]
}
model PromotionRoomType {
  promotionId String
  roomTypeId String
  promotion Promotion @relation(fields: [promotionId],references:[id])
  roomType RoomType @relation(fields: [roomTypeId],references:[id])
  @@id([promotionId,roomTypeId])
}
model PromotionRoom {
  promotionId String
  roomId String
  promotion Promotion @relation(fields: [promotionId],references:[id])
  room Room @relation(fields: [roomId],references:[id])
  @@id([promotionId,roomId])
}
model PromotionRedemption {
  id String @id @default(uuid())
  promotionId String
  promotion Promotion @relation(fields:[promotionId],references:[id])
  reservationId String @unique
  reservation Reservation @relation(fields:[reservationId],references:[id])
  emailHash String
  amount Int
  releasedAt DateTime?
  createdAt DateTime @default(now())
  @@index([promotionId,emailHash,releasedAt])
}
model GalleryItem {
  id String @id @default(uuid())
  objectKey String
  url String
  alt String
  caption String
  position Int @default(0)
  archived Boolean @default(false)
  createdAt DateTime @default(now())
}
model Notification {
  id String @id @default(uuid())
  title String
  reservationId String
  readAt DateTime?
  createdAt DateTime @default(now())
}
model AuditLog {
  id String @id @default(uuid())
  actorId String?
  action String
  entityType String
  entityId String
  metadata Json
  source String @default("API")
  createdAt DateTime @default(now())
  @@index([entityType,entityId,createdAt])
}
model SystemSettings {
  id String @id @default("hotel")
  emailVerificationRequired Boolean @default(true)
  mobileRequired Boolean @default(true)
  cancellationCutoffHours Int @default(24)
  unverifiedExpiryMinutes Int @default(30)
  maxRooms Int @default(4)
  maxStayNights Int @default(30)
  confirmationMode String @default("MANUAL")
  timezone String @default("Asia/Manila")
  checkInHour Int @default(14)
  updatedAt DateTime @updatedAt
}
model HotelContent {
  id String @id @default("hotel")
  headline String @default("A little closer to the sun.")
  introduction String @default("Unhurried days. Thoughtful stays.")
  about String
  address String
  email String
  phone String
  mapUrl String?
  amenities String[]
  updatedAt DateTime @updatedAt
}
model OutboxJob {
  id String @id @default(uuid())
  kind String
  encryptedPayload String
  dedupeKey String @unique
  attempts Int @default(0)
  availableAt DateTime @default(now())
  lockedUntil DateTime?
  leaseId String?
  completedAt DateTime?
  failedAt DateTime?
  lastError String?
  createdAt DateTime @default(now())
  @@index([completedAt,availableAt])
}
model EmailQuota {
  key String @id
  count Int
  resetAt DateTime
}
model Integration {
  id String @id @default(uuid())
  provider String @unique
  enabled Boolean @default(false)
  secretReference String?
  properties ExternalPropertyMapping[]
  rooms ExternalRoomMapping[]
  rates ExternalRateMapping[]
  syncLogs IntegrationSyncLog[]
  webhooks WebhookEvent[]
}
model ExternalPropertyMapping {
  id String @id @default(uuid())
  integrationId String
  integration Integration @relation(fields:[integrationId],references:[id])
  externalId String
  @@unique([integrationId,externalId])
}
model ExternalRoomMapping {
  id String @id @default(uuid())
  integrationId String
  integration Integration @relation(fields:[integrationId],references:[id])
  externalId String
  internalRoomTypeId String
  @@unique([integrationId,externalId])
}
model ExternalRateMapping {
  id String @id @default(uuid())
  integrationId String
  integration Integration @relation(fields:[integrationId],references:[id])
  externalId String
  internalRateKey String
  @@unique([integrationId,externalId])
}
model IntegrationSyncLog {
  id String @id @default(uuid())
  integrationId String
  integration Integration @relation(fields:[integrationId],references:[id])
  status String
  safeSummary String
  createdAt DateTime @default(now())
}
model WebhookEvent {
  id String @id @default(uuid())
  integrationId String
  integration Integration @relation(fields:[integrationId],references:[id])
  externalEventId String
  receivedAt DateTime @default(now())
  processedAt DateTime?
  @@unique([integrationId,externalEventId])
}
