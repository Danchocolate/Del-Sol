    "@fastify/multipart": "10.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@hotel/shared": "1.0.0",
    "@prisma/client": "6.19.3",
    "@sentry/node": "10.75.2",
    "better-auth": "1.7.5",
    "date-fns-tz": "3.2.0",
